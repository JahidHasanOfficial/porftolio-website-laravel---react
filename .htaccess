<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Security: Block sensitive files and folders
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^\.git - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package\.(json|lock) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor) - [F,L,NC]
    RewriteRule ^storage/logs/ - [F,L,NC]

    # Handle Front Controller - Redirect to /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent directory browsing
Options -Indexes

